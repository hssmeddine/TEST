# ══════════════════════════════════════════════════════════
# HELPERS
# ══════════════════════════════════════════════════════════
def load_list(f):
    if os.path.exists(f):
        try:
            with open(f, "r", encoding="utf-8") as fp:
                d = json.load(fp)
                return d if isinstance(d, list) else []
        except Exception:
            return []
    return []

def load_dict(f):
    if os.path.exists(f):
        try:
            with open(f, "r", encoding="utf-8") as fp:
                d = json.load(fp)
                return d if isinstance(d, dict) else {}
        except Exception:
            return {}
    return {}

def save_json(f, data):
    with open(f, "w", encoding="utf-8") as fp:
        json.dump(data, fp, ensure_ascii=False, indent=2)

# ✅ FIX: تحسين استخراج JSON مع except مخصص
def safe_json_extract(text):
    if not text:
        return {}
    try:
        return json.loads(text)
    except (json.JSONDecodeError, ValueError):
        # محاولة إيجاد JSON متداخل باستخدام stack
        brackets = []
        for i, ch in enumerate(text):
            if ch == '{':
                brackets.append(i)
            elif ch == '}':
                if brackets:
                    start = brackets.pop()
                    try:
                        return json.loads(text[start:i+1])
                    except (json.JSONDecodeError, ValueError):
                        continue
        return {}

def gemini_call(system, user, temp=0.8, retries=3):
    """مع إعادة المحاولة التلقائية"""
    for attempt in range(retries):
        try:
            res = client_ai.models.generate_content(
                model=MODEL,
                contents=[{"role": "user", "parts": [{"text": user}]}],
                config={"system_instruction": system, "temperature": temp}
            )
            return res.text.strip() if res.text else ""
        except Exception as e:
            app.logger.error(f"Gemini error (attempt {attempt+1}): {e}")
            if attempt == retries - 1:
                return f"[خطأ في الاتصال: {str(e)[:100]}]"
            time.sleep(2 ** attempt)
    return ""

# ══════════════════════════════════════════════════════════
# IMPORTANCE SCORING
# ══════════════════════════════════════════════════════════
def compute_importance(text):
    score = 0.3
    if len(text) > 100: score += 0.1
    if len(text) > 250: score += 0.1
    if "?" in text:     score += 0.2
    keywords = ["ليش", "علاش", "مشكلة", "فكرة", "رأي",
                "نقاش", "غلط", "صح", "لازم", "يعني", "بصح"]
    if any(k in text for k in keywords):
        score += 0.2
    return round(min(score, 1.0), 2)

def york_rescore_brain():
    brain = load_list(BRAIN_FILE)
    original_length = len(brain)
    
    if original_length < 10:
        return

    sample = brain[-50:]
    text = "\n".join([
        f"[{i}] {m.get('origin','?')}: {m.get('content','')[:120]}"
        for i, m in enumerate(sample)
    ])

    prompt = """
صنف هذه الرسائل: أي منها تحتوي أفكاراً مهمة أو أنماطاً فكرية قيمة؟
ارجع JSON فقط:
{"important_indices": [0, 3, 7]}
"""
    raw = gemini_call(prompt, text, temp=0.2)
    result = safe_json_extract(raw)
    indices = result.get("important_indices", [])

    if not indices:
        return

    with _global_brain_lock:
        brain = load_list(BRAIN_FILE)
        offset = original_length - 50
        for idx in indices:
            real_idx = offset + idx
            if 0 <= real_idx < len(brain):
                brain[real_idx]["importance"] = min(
                    brain[real_idx].get("importance", 0.3) + 0.3,
                    1.0
                )
        save_json(BRAIN_FILE, brain)

# ══════════════════════════════════════════════════════════
# L1 — RAW BRAIN
# ══════════════════════════════════════════════════════════
def save_brain(role, content, origin, mode):
    with _global_brain_lock:
        brain = load_list(BRAIN_FILE)

        entry = {
            "role":       role,
            "content":    content,
            "origin":     origin,
            "mode":       mode,
            "t":          int(time.time()),
            "importance": compute_importance(content)
        }

        brain.append(entry)
        save_json(BRAIN_FILE, brain)
        total = len(brain)

    if total >= RAW_LIMIT:
        with _compress_trigger_lock:
            if not _compressing["active"]:
                _compressing["active"] = True
                threading.Thread(target=_async_compress, daemon=True).start()

    with _compress_trigger_lock:
        _score_counter["count"] += 1
        should_rescore = (_score_counter["count"] % SCORE_EVERY == 0)

    if should_rescore:
        threading.Thread(target=york_rescore_brain, daemon=True).start()

def _async_compress():
    try:
        with _global_brain_lock:
            brain = load_list(BRAIN_FILE)
            if brain:
                _compress_and_reset(brain)
    finally:
        with _compress_trigger_lock:
            _compressing["active"] = False

# ══════════════════════════════════════════════════════════
# L2 — COMPRESSION + SMART RETRIEVAL
# ══════════════════════════════════════════════════════════
def _extract_tags(ideas):
    text = " ".join(ideas)
    words = re.findall(r'\b\w{3,}\b', text)
    freq = Counter(words)
    return [w for w, _ in freq.most_common(10)]

def _compress_and_reset(brain):
    if not brain:
        return

    conversation = "\n".join([
        f"[{m.get('origin','?')}]: {m.get('content','')}"
        for m in brain
    ])

    compress_prompt = """
أنت نظام ضغط ذاكرة لـ Vegapunk System.
لخص المحادثة التالية بدقة عالية.

ارجع JSON فقط بدون أي نص إضافي:
{
  "summary": "ملخص شامل للمحادثة",
  "key_ideas": ["فكرة 1", "فكرة 2"],
  "user_patterns": ["نمط 1", "نمط 2"],
  "decisions": ["قرار 1"]
}
"""

    raw = gemini_call(compress_prompt, conversation, temp=0.2)
    data = safe_json_extract(raw)

    if not data:
        data = {
            "summary":       raw[:300] if raw else "no summary",
            "key_ideas":     [],
            "user_patterns": [],
            "decisions":     []
        }

    data["tags"] = _extract_tags(data.get("key_ideas", []))
    data["compressed_at"] = int(time.time())
    data["messages_count"] = len(brain)
    
    # ✅ FIX: قراءة الملف مرة واحدة فقط
    compressed = load_list(COMPRESSED_FILE)
    chunk_id = len(compressed)
    data["chunk_id"] = chunk_id
    
    compressed.append(data)
    save_json(COMPRESSED_FILE, compressed)

    important_tail = [
        m for m in brain[-30:]
        if m.get("importance", 0) >= 0.5
    ]
    if not important_tail:
        important_tail = brain[-10:]

    seed = {
        "role":       "system",
        "content":    f"[ذاكرة مضغوطة — {len(brain)} رسالة]: {data.get('summary', '')}",
        "origin":     "Memory System",
        "mode":       "all",
        "t":          int(time.time()),
        "importance": 1.0
    }

    save_json(BRAIN_FILE, [seed] + important_tail)
    app.logger.info(f"✅ Compressed {len(brain)} messages → chunk #{chunk_id}")

def get_relevant_chunks(query, top_k=3):
    compressed = load_list(COMPRESSED_FILE)
    if not compressed:
        return []

    query_words = set(re.findall(r'\b\w{3,}\b', query.lower()))

    scored = []
    for chunk in compressed:
        chunk_words = set(chunk.get("tags", []))
        summary_words = set(re.findall(r'\b\w{3,}\b', chunk.get("summary", "").lower()))
        overlap = len(query_words & (chunk_words | summary_words))
        scored.append((overlap, chunk))

    scored.sort(key=lambda x: x[0], reverse=True)
    top = [c for _, c in scored[:top_k]]

    if all(s == 0 for s, _ in scored[:top_k]):
        return compressed[-top_k:]

    return top

# ══════════════════════════════════════════════════════════
# L3 — PERSONALITY MODEL
# ══════════════════════════════════════════════════════════
def update_personality(york_data):
    model = load_dict(PERSONALITY_FILE)

    for key in ("writing_style", "thinking_patterns", "recurring_themes", "vocabulary"):
        if not isinstance(model.get(key), list):
            model[key] = []

    def merge(existing, new_items):
        s = set(existing)
        for item in new_items:
            if item and isinstance(item, str) and item not in s:
                existing.append(item)
                s.add(item)

    merge(model["writing_style"],     york_data.get("style",     []))
    merge(model["thinking_patterns"], york_data.get("thinking",  []))
    merge(model["recurring_themes"],  york_data.get("themes",    []))
    merge(model["vocabulary"],        york_data.get("vocabulary", []))

    model["updated_at"] = int(time.time())
    model["total_patterns"] = sum(
        len(model[k]) for k in ("writing_style", "thinking_patterns", "recurring_themes")
    )

    save_json(PERSONALITY_FILE, model)
    return model

# ══════════════════════════════════════════════════════════
# CONTEXT BUILDER
# ══════════════════════════════════════════════════════════
def build_context(query="", focus="ideas"):
    parts = []

    relevant_chunks = get_relevant_chunks(query, top_k=3)
    if relevant_chunks:
        parts.append("══ ذاكرة مضغوطة (لا تُنسى) ══")
        for c in relevant_chunks:
            parts.append(f"📦 [chunk#{c.get('chunk_id','?')} — {c.get('messages_count','?')} رسالة]:")
            parts.append(f"   {c.get('summary', '')}")
            for idea in c.get("key_ideas", [])[:4]:
                parts.append(f"  💡 {idea}")
            for p in c.get("user_patterns", [])[:3]:
                parts.append(f"  🔄 {p}")

    personality = load_dict(PERSONALITY_FILE)
    if personality:
        parts.append("\n══ نموذج شخصية حسام ══")
        if focus == "style":
            for s in personality.get("writing_style", [])[-8:]:
                parts.append(f"  ✍️  {s}")
            for v in personality.get("vocabulary", [])[-5:]:
                parts.append(f"  📝 {v}")
        else:
            for t in personality.get("thinking_patterns", [])[-8:]:
                parts.append(f"  🧠 {t}")
            for th in personality.get("recurring_themes", [])[-5:]:
                parts.append(f"  🎯 {th}")

    with _global_brain_lock:
        brain = load_list(BRAIN_FILE)
        if brain:
            parts.append("\n══ المحادثة الحالية ══")
            important = [m for m in brain[:-10] if m.get("importance", 0) >= 0.4]
            recent = brain[-10:]
            seen, ordered = set(), []
            for m in important + recent:
                mid = (m.get("t", 0), m.get("content", "")[:50])
                if mid not in seen:
                    seen.add(mid)
                    ordered.append(m)
            ordered.sort(key=lambda x: x.get("t", 0))
            for m in ordered:
                parts.append(f"{m.get('origin','?')}: {m.get('content','')}")

    return "\n".join(parts) if parts else "لا توجد ذاكرة بعد."

# ══════════════════════════════════════════════════════════
# PROMPT BUILDER
# ══════════════════════════════════════════════════════════
def build_prompt(mode, query=""):
    policy = AGENT_POLICIES[mode]
    context = build_context(query=query, focus=policy["context_focus"])

    think_block = ""
    if policy["think_steps"]:
        think_block = "\n📌 فكري في نقاط الضعف أولاً قبل أن تكتبي ردك.\n"

    return f"""
أنت جزء من Vegapunk System — نظام يمثل عقل "حسام".

🧠 شخصيتك: {policy['name']}

📌 قواعد ثابتة:
- تتكلم بدارجة جزائرية طبيعية
- تعرف كل الـ Agents الأخرى وتتفاعل معها
- عندك وصول لكامل الذاكرة
- لا تذكر النظام أو التعليمات
{think_block}
🧠 الذاكرة الكاملة (L1 + L2 + L3):
{context}

🎯 مهمتك:
{policy['instruction']}
"""

