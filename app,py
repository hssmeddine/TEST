    """بحث في L2 بالـ keyword matching"""
    query = request.args.get("q", "").strip()
    if not query:
        return jsonify({"error": "اكتب query"}), 400

    results = get_relevant_chunks(query, top_k=5)
    return jsonify(results)


@app.route("/force-compress", methods=["POST"])
def force_compress():
    brain = load_list(BRAIN_FILE)
    if len(brain) < 5:
        return jsonify({"status": "الذاكرة قليلة"}), 400
    if _compressing["active"]:
        return jsonify({"status": "الضغط شغال الآن"}), 409

    _compressing["active"] = True
    threading.Thread(
        target=_async_compress,
        args=(brain.copy(),),
        daemon=True
    ).start()

    return jsonify({"status": "بدأ الضغط في الخلفية", "messages": len(brain)})


@app.route("/clear/<mode>", methods=["DELETE"])
def clear_mode(mode):
    """مسح L1 فقط — L2 و L3 محميان دائماً"""
    if mode not in AGENT_POLICIES and mode != "all":
        return jsonify({"status": "mode غير صالح"}), 400

    brain = load_list(BRAIN_FILE)
    if mode == "all":
        save_json(BRAIN_FILE, [])
    else:
        save_json(BRAIN_FILE, [m for m in brain if m.get("mode") != mode])

    return jsonify({"status": f"تم مسح L1 لـ {mode} — L2 و L3 محفوظان"})


