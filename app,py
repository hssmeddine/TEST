@app.route("/chat", methods=["POST"])
def chat():
    """Single Agent chat"""
    data = request.get_json()
    msg  = data.get("message", "").strip()
    mode = data.get("mode", "shaka")

    if not msg:
        return jsonify({"reply": "اكتب رسالة"}), 400
    if mode not in AGENT_POLICIES:
        return jsonify({"reply": "mode غير صالح"}), 400

    try:
        policy = AGENT_POLICIES[mode]
        prompt = build_prompt(mode, query=msg)
        reply  = gemini_call(prompt, msg, temp=policy["temperature"])

        if not reply:
            return jsonify({"reply": "ما جا رد، عاود"}), 500

        # ✅ save_brain async — لا يبلوك
        save_brain("user",      msg,   "Houssam",        mode)
        save_brain("assistant", reply, policy["name"],   mode)

        if mode == "york":
            result = safe_json_extract(reply)
            if result:
                update_personality(result)

        return jsonify({"reply": reply})

    except Exception as e:
        app.logger.error(f"Chat error [{mode}]: {e}")
        return jsonify({"reply": "صرا خطأ، عاود بعد شوية"}), 500


@app.route("/think", methods=["POST"])
def think():
    """
    Orchestrator — كل الـ Agents يردوا معاً + رأي نهائي مدمج
    """
    data = request.get_json()
    msg  = data.get("message", "").strip()

    if not msg:
        return jsonify({"error": "اكتب رسالة"}), 400

    try:
        results = {}

        for mode, policy in AGENT_POLICIES.items():
            prompt        = build_prompt(mode, query=msg)
            reply         = gemini_call(prompt, msg, temp=policy["temperature"])
            results[mode] = reply or "..."
            save_brain("assistant", reply, policy["name"], mode)

        # York تحدّث الشخصية
        york_data = safe_json_extract(results.get("york", ""))
        if york_data:
            update_personality(york_data)

        # سؤال المستخدم مرة واحدة
        save_brain("user", msg, "Houssam", "orchestrator")

        # Orchestrator يدمج الردود
        synthesis_prompt = """
أنت Orchestrator لـ Vegapunk System.
لديك ردود 3 Agents على نفس السؤال.
اكتب رأي نهائي موحد ومختصر يجمع أهم نقاطهم.
اكتب بدارجة جزائرية. كن مباشراً ودقيقاً.
"""
        agents_text = "\n\n".join([
            f"[{AGENT_POLICIES[m]['name']}]:\n{results[m]}"
            for m in ("shaka", "lilith", "atlas")
        ])

        final          = gemini_call(synthesis_prompt, agents_text, temp=0.7)
        results["final"] = final or "..."

        return jsonify(results)

    except Exception as e:
        app.logger.error(f"Think error: {e}")
        return jsonify({"error": "صرا خطأ"}), 500


@app.route("/get-chat/<mode>")
def get_chat(mode):
    if mode not in AGENT_POLICIES and mode != "orchestrator":
        return jsonify([]), 400

    brain = load_list(BRAIN_FILE)
    return jsonify([
        {"role": m["role"], "content": m["content"]}
        for m in brain
        if m.get("mode") == mode
    ])


